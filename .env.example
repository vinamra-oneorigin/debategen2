# Environment Configuration for Async Podcast Generator

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-1106-preview

# ElevenLabs TTS Configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL=eleven_flash_v2_5

# Voice ID Configuration (get these from ElevenLabs voice library)
ELEVENLABS_MALE_VOICE_ID=your-male-voice-id
ELEVENLABS_FEMALE_VOICE_ID=your-female-voice-id

# Optional: Additional API Keys
ANTHROPIC_API_KEY=your-anthropic-key-if-needed
GEMINI_API_KEY=your-gemini-key-if-needed